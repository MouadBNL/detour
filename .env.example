# Copy to .env (git-ignored). Read by apps/web (vite.config.ts) and e2e. apps/api runs on Wrangler,
# which reads its own apps/api/.dev.vars instead (see apps/api/.dev.vars.example).

# Port the web dev server proxies /rpc and /api/auth to. `wrangler dev` listens on `dev.port` in
# apps/api/wrangler.jsonc (3001): change both together.
API_PORT=3001

# Port of the web dev server (apps/web).
WEB_PORT=5173

# The local D1 database lives in apps/api/.wrangler (git-ignored); `pnpm dev` migrates it.

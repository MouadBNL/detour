{
  "name": "@detour/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler types --env-interface Bindings && wrangler d1 migrations apply DB --local && wrangler dev",
    "types": "wrangler types --env-interface Bindings",
    "build": "wrangler deploy --dry-run --outdir dist",
    "ship": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vp test --no-cache --no-fsModuleCache"
  },
  "dependencies": {
    "@detour/contracts": "workspace:*",
    "@detour/db": "workspace:*",
    "@detour/result": "workspace:*",
    "@orpc/server": "catalog:",
    "@workos-inc/node": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}

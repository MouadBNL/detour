# Dependencies and caches (Vite+ task cache lives in node_modules/.vite)
node_modules

# Build output
dist
*.tsbuildinfo

# Wrangler local state (D1 database of `pnpm dev`, under apps/api/.wrangler)
.wrangler

# Environment: copy .env.example to .env
.env
.env.*
!.env.example
# Wrangler's local secrets for apps/api: copy apps/api/.dev.vars.example to apps/api/.dev.vars
.dev.vars
.dev.vars.*
!.dev.vars.example

# Logs
*.log

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store

# AI agent worktrees
.claude/worktrees/

# TanStack Router generator scratch files
.tanstack

# Wrangler generated types (`pnpm -C apps/api types`; check:static and dev regenerate them)
apps/api/worker-configuration.d.ts

# WXT generated types and extension build output
.wxt
.output

# Playwright output (e2e/): traces and screenshots of failed journeys, HTML report
e2e/test-results
e2e/playwright-report

# Vitest failure attachments
.vitest

# Git hook shims, generated by `vp install` (vp config); the hook itself is .vite-hooks/pre-commit
.vite-hooks/_
